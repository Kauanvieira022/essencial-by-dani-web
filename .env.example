NODE_ENV=development
PORT=3000

# Conta única da administradora. Preencha localmente; não coloque credenciais reais neste exemplo.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gere um valor aleatório de pelo menos 32 bytes. Mantenha-o privado.
SESSION_SECRET=

# Opcional. Vazio usa a pasta de dados local do usuário.
DATABASE_PATH=
